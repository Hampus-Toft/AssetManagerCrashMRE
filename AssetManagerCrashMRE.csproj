<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>AssetManagerCrashMRE</AssemblyName>
    <RootNamespace>AssetManagerCrashMRE</RootNamespace>
    <!-- Cosmetic facade-version conflict from Valheim's Mono-era assemblies; nothing is copied to output. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <!-- HarmonyOrderProof is a separate, game-free console project; keep its sources out of the plugin build. -->
  <ItemGroup>
    <Compile Remove="HarmonyOrderProof\**" />
    <EmbeddedResource Remove="HarmonyOrderProof\**" />
    <None Remove="HarmonyOrderProof\**" />
  </ItemGroup>

  <!-- Override with the VALHEIM_INSTALL_DIR env var or -p:ValheimInstallDir="..." -->
  <PropertyGroup>
    <ValheimInstallDir Condition="'$(VALHEIM_INSTALL_DIR)' != ''">$(VALHEIM_INSTALL_DIR)</ValheimInstallDir>
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>
    <JotunnDllPath Condition="'$(JotunnDllPath)' == ''">$(ValheimInstallDir)\BepInEx\plugins\Jotunn\Jotunn.dll</JotunnDllPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(ValheimInstallDir)\BepInEx\core\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(ValheimInstallDir)\BepInEx\core\BepInEx.dll</HintPath>
    </Reference>
    <Reference Include="assembly_valheim">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\assembly_valheim.dll</HintPath>
    </Reference>
    <Reference Include="SoftReferenceableAssets">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\SoftReferenceableAssets.dll</HintPath>
    </Reference>
    <Reference Include="Jotunn">
      <HintPath>$(JotunnDllPath)</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ValheimInstallDir)\valheim_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>

  <Target Name="CheckJotunnReference" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(JotunnDllPath)')" Text="Jotunn.dll not found at '$(JotunnDllPath)'. Install Jotunn 2.30.0 or pass -p:JotunnDllPath=&quot;...&quot;." />
  </Target>

  <!-- Opt-in only: dotnet build -c Release -p:DeployToGame=true. Never touches the running game process. -->
  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(ValheimInstallDir)\BepInEx\plugins" />
  </Target>

  <!--
    Opt-in only: dotnet build -c Release -p:ThunderstorePackage=true
    Produces bin\thunderstore\$(AssemblyName).zip (manifest.json, icon.png, README.md and the plugin DLL at the zip root),
    which Thunderstore Mod Manager / r2modman can install via Settings > Profile > "Import local mod".
    Edit Thunderstore\manifest.json to change the version or dependencies.
  -->
  <Target Name="ThunderstorePackage" AfterTargets="Build" Condition="'$(ThunderstorePackage)' == 'true'">
    <PropertyGroup>
      <ThunderstoreStagingDir>$(MSBuildProjectDirectory)\obj\thunderstore\</ThunderstoreStagingDir>
      <ThunderstoreOutputDir>$(MSBuildProjectDirectory)\bin\thunderstore\</ThunderstoreOutputDir>
      <ThunderstoreZip>$(ThunderstoreOutputDir)$(AssemblyName).zip</ThunderstoreZip>
    </PropertyGroup>
    <RemoveDir Directories="$(ThunderstoreStagingDir)" />
    <MakeDir Directories="$(ThunderstoreStagingDir);$(ThunderstoreOutputDir)" />
    <Copy SourceFiles="$(TargetPath);$(MSBuildProjectDirectory)\Thunderstore\manifest.json;$(MSBuildProjectDirectory)\Thunderstore\icon.png;$(MSBuildProjectDirectory)\README.md" DestinationFolder="$(ThunderstoreStagingDir)" />
    <Delete Files="$(ThunderstoreZip)" />
    <ZipDirectory SourceDirectory="$(ThunderstoreStagingDir)" DestinationFile="$(ThunderstoreZip)" />
    <Message Importance="high" Text="Thunderstore package: $(ThunderstoreZip)" />
  </Target>

</Project>
